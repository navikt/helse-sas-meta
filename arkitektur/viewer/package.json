{
  "name": "arkitektur-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Lokalt, interaktivt dev-verktøy for å vise flyt-JSON generert av arkitekturagenten. Ingen del av produksjonsapplikasjonene.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
