{
  "kilde": "navikt/helse-sp-forsikring",
  "repo": {
    "archived": false,
    "default_branch": "main",
    "has_issues": false,
    "has_projects": false,
    "has_wiki": false,
    "has_discussions": false,
    "allow_merge_commit": false,
    "allow_squash_merge": false,
    "allow_rebase_merge": true,
    "allow_auto_merge": true,
    "allow_update_branch": true,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "COMMIT_OR_PR_TITLE",
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "merge_commit_title": "MERGE_MESSAGE",
    "merge_commit_message": "PR_TITLE",
    "web_commit_signoff_required": false
  },
  "branchProtection": null,
  "rulesets": {
    "main-dependabot-pull-requests": {
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/heads/main"
          ]
        }
      },
      "bypass_actors": [
        {
          "actor_type": "RepositoryRole",
          "actor_id": 5,
          "bypass_mode": "exempt"
        }
      ],
      "rules": [
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": true,
            "required_status_checks": [
              {
                "context": "Bygg og test",
                "integration_id": 15368
              },
              {
                "context": "Dependency review",
                "integration_id": 15368
              }
            ]
          }
        }
      ]
    },
    "main-restrictions-for-all": {
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/heads/main"
          ]
        }
      },
      "bypass_actors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_linear_history"
        }
      ]
    }
  },
  "teams": {
    "appsec": "pull",
    "isoc": "pull",
    "nais-billing": "pull",
    "security-managers": "pull",
    "team-sas": "admin"
  },
  "direkteSamarbeidspartnere": {},
  "sikkerhet": {
    "vulnerability_alerts": true,
    "automated_security_fixes": true,
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "dependabot_security_updates": "enabled",
    "secret_scanning_non_provider_patterns": "enabled",
    "secret_scanning_ai_detection": "disabled",
    "secret_scanning_validity_checks": "enabled",
    "secret_scanning_delegated_alert_dismissal": "disabled",
    "secret_scanning_delegated_bypass": "disabled"
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": false
  },
  "workflowPermissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": true
  }
}
